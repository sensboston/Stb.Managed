<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(StbTestTargets)</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <DefineConstants Condition="'$(TestNetStandard)' == 'true'">$(DefineConstants);TEST_NETSTANDARD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup Condition="'$(TestNetStandard)' != 'true'">
    <ProjectReference Include="..\..\src\Stb.Managed\Stb.Managed.csproj" />
    <ProjectReference Include="..\..\src\Stb.Managed.Gpu\Stb.Managed.Gpu.csproj" />
    <ProjectReference Include="..\Stb.Managed.Oracle\Stb.Managed.Oracle.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TestNetStandard)' == 'true'">
    <Compile Remove="Gpu\**\*.cs" />
    <ProjectReference Include="..\..\src\Stb.Managed\Stb.Managed.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <ProjectReference Include="..\Stb.Managed.Oracle\Stb.Managed.Oracle.csproj" />
  </ItemGroup>
</Project>
